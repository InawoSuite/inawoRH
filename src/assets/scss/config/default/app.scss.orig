// Reset all list styles globally
ul,
ol,
li {
  list-style: none !important;
  list-style-type: none !important;
  -webkit-padding-start: 0 !important;
  padding-inline-start: 0 !important;
  margin: 0 !important;
  padding: 0 !important;
}

// Bootstrap overrides
.nav,
.navbar-nav,
.nav-item,
.dropdown-menu {
  list-style: none !important;
  padding-left: 0 !important;
  margin: 0 !important;
}



// Specific navigation styles
#two-column-menu,
.navbar-menu,
.twocolumn-iconview,
.nav-sm {
  * {
    list-style: none !important;
    list-style-type: none !important;
  }

  ul,
  ol,
  li {
    &::marker,
    &::before,
    &::after {
      content: none !important;
      display: none !important;
    }
  }
}

// Force override any other styles
[class*="nav-"] li,
[class*="menu-"] li {
  list-style: none !important;
  list-style-type: none !important;
}

// Global styles to remove list markers
#two-column-menu,
.navbar-menu,
.twocolumn-iconview,
.nav,
.nav-sm,
.nav-item,
[class*="nav-"],
.menu-link,
.menu-dropdown {
  ul,
  ol,
  li {
    list-style: none !important;
    list-style-type: none !important;
    -webkit-padding-start: 0 !important;
    padding-inline-start: 0 !important;
    margin: 0 !important;
    padding: 0 !important;

    &::marker,
    &::before,
    &::after {
      display: none !important;
      content: none !important;
    }
  }
}

// Override any Bootstrap list styles
.nav {
  --bs-nav-link-padding-x: 0;
  --bs-nav-link-padding-y: 0;
  list-style: none !important;
  padding-left: 0 !important;
}

.hov-mylink:hover {
  color: black;
}

.hov-mylink {
  display: block;
}
.nav-item {
  list-style-type: none !important; // Assurez-vous que les tirets sont supprimés
  padding-left: 0 !important; // Enlève le retrait à gauche
  margin-left: 0 !important; // Enlève la marge à gauche
}
ul li:hover,
ol li:hover {
  list-style-type: none !important; // Assurez-vous que les tirets sont supprimés en état de survol
}

ul,
ol {
  text-decoration: none;
  list-style: none !important; // Ajoutez !important pour forcer l'application du style
  padding-left: 0 !important; // Ajoutez !important pour forcer l'application du style
  margin-left: 0 !important; // Ajoutez !important pour forcer l'application du style
}

.box-line-code {
  font-size: 24px;
  border: 1px solid rgba(0, 0, 0, 0);
  border-radius: 50%;
  position: relative;
  font-weight: 400;
  line-height: 19.5px;
  color: rgb(135, 138, 153);
}

/* Assurez-vous que le tooltip peut dépasser la barre latérale */
[aria-describedby^="tooltip-"] {
  z-index: 9999; /* Assurez-vous que le tooltip s'affiche au-dessus des autres éléments */
}

/* Ajustez la position du tooltip pour qu'il s'affiche correctement à droite du logo */
#tooltip-logo {
  transform: translateX(
    10px
  ); /* Ajustez cette valeur en fonction de vos besoins */
}

.nav-icon.active, .nav-link.active 
{
  background-color: var(--vz-body-bg);
  color: #014a92 !important;
}

.nav-icon.active i,.nav-link.active i {
  color: #014a92 !important ; /* Couleur de l'icône active */


}
 