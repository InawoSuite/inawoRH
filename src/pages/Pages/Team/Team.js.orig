import axios from 'axios';



const Team = () => {
    document.title = "Team | Velzon - React Admin & Dashboard Template";

      //  Ajout des états de chargement et d'erreur
      const [isLoading, setIsLoading] = useState(true);
      const [error, setError] = useState(null);

    // 2. Modification de l'initialisation de userData

    // Création d'une instance axios avec la configuration de base
        const axiosInstance = axios.create({
            baseURL: 'http://inawoapiv3.inawo.pro',
            headers: {
                'Content-Type': 'application/json'
            }
        });

        // Ajout de l'intercepteur pour le token
        axiosInstance.interceptors.request.use((config) => {
            const token = localStorage.getItem('token');
            if (token) {
                config.headers.Authorization = `Bearer ${token}`;
            }
            return config;
        });


    const [userData, setUserData] = useState(() => {
        try {
            const token = localStorage.getItem('token');
            if (!token) {
                setError('Pas de token trouvé');
                return null;
            }

            const savedData = localStorage.getItem('userData');
            if (!savedData) {
                setError('Données utilisateur non trouvées');
                return null;
            }

            const parsedData = JSON.parse(savedData);
            if (!parsedData.magasins?.length) {
                setError('Aucun magasin disponible');
                return null;
            }

            return parsedData;
        } catch (error) {
            console.error('Erreur d\'initialisation:', error);
            setError(error.message);
            return null;
        } finally {
            setIsLoading(false);
        }
    });
    const permissions = [
        {
            id: 'contact',
            label: 'Contact',
            description: 'Votre collaborateur pourra ajouter ou modifier vos contacts'
        },
        {
            id: 'catalogue',
            label: 'Catalogue',
            description: 'Votre collaborateur pourra ajouter ou modifier vos catalogues'
        },
        {
            id: 'agenda',
            label: 'Agenda',
            description: 'Votre collaborateur pourra ajouter ou modifier vos agendas'
        },
        {
            id: 'facturation',
            label: 'Facturation',
            description: 'Votre collaborateur pourra ajouter ou modifier vos factures'
        },
        {
            id: 'opportunites',
            label: 'Opportunités',
            description: 'Votre collaborateur pourra ajouter ou modifier vos opportunités '
        },
        {
            id: 'taches',
            label: 'Taches',
            description: 'Votre collaborateur pourra ajouter ou modifier vos tâches'
        },
        {
            id: 'reception',
            label: 'Bon de réception',
            description: 'Votre collaborateur pourra ajouter ou modifier vos bons de réception'
        },
        {
            id: 'normalise',
            label: 'Facture normalisé',
            description: 'Votre collaborateur pourra ajouter ou modifier vos factures normalisées'
        },
        {
            id: 'stock',
            label: 'Stock',
            description: 'Votre collaborateur pourra ajouter ou modifier vos stocks'
        },
        {
            id: 'stockIntegral',
            label: 'Stock intégral',
            description: 'Votre collaborateur pourra ajouter ou modifier vos stocks intégraux'
        },
        {
            id: 'livraison',
            label: 'Bon de livraison',
            description: 'Votre collaborateur pourra ajouter ou modifier vos bons de livraison'
        },
        {
            id: 'avoir',
            label: "Bon d'avoir",
            description: "Votre collaborateur pourra ajouter ou modifier vos bons d'avoir"
        },
        {
            id: 'sortie',
            label: 'Bon de sortie',
            description: 'Votre collaborateur pourra ajouter ou modifier vos bons de sortie'
        },
        {
            id: 'approvisionnement',
            label: 'Approvisionnement',
            description: 'Votre collaborateur pourra ajouter ou modifier vos approvisionnements'
        },
        {
            id: 'transfert',
            label: 'Bon de transfert',
            description: 'Votre collaborateur pourra ajouter ou modifier vos transferts de stock'
        },
        {
            id: 'vente',
            label: 'Vente',
            description: 'Votre collaborateur pourra ajouter ou modifier vos ventes'
        },
        {
            id: 'commande',
            label: 'Bon de commande',
            description: 'Votre collaborateur pourra ajouter ou modifier vos bons de commande'
        },
        {
            id: 'depenses',
            label: 'Dépenses',
            description: 'Votre collaborateur pourra ajouter ou modifier vos dépenses'
        }
    ];


    // 1. Redux
    const dispatch = useDispatch();
    const selectteamData = createSelector(
        (state) => state.Team,
        (teamData) => teamData.teamData
    );
    const teamData = useSelector(selectteamData);

   

    // 2. États
    // 2.1 États principaux
    
    const [teamList, setTeamList] = useState([]);

    const fetchUsers = useCallback(async () => {
        try {
            const token = localStorage.getItem('token');
            if (!token) {
                throw new Error('Token non trouvé');
            }
    
            const response = await fetch('http://inawoapiv3.inawo.pro/utilisateurs/list', {
                headers: {
                    'Authorization': `Bearer ${token}`,
                    'Accept': 'application/json',
                    'Content-Type': 'application/json'
                }
            });
    
            if (!response.ok) {
                throw new Error(`Erreur HTTP: ${response.status}`);
            }
    
            const data = await response.json();
            setTeamList(data);
        } catch (error) {
            console.error("Erreur lors de la récupération des utilisateurs:", error);
            setError(error.message);
        }
    }, []); 

    // 3. useEffect pour appeler fetchUsers
    useEffect(() => {
        fetchUsers();
    }, [fetchUsers]); // Ajouter fetchUsers comme dépendance



    const [searchTerm, setSearchTerm] = useState('');

    // 2.2 États pour les modals et édition
    const [modal, setModal] = useState(false);
    const [isEdit, setIsEdit] = useState(false);
    const [deleteModal, setDeleteModal] = useState(false);
    const [team, setTeam] = useState(null);
    const [teamMem, setTeamMem] = useState(null);

    // 2.3 États pour les dropdowns
    const [dropdownOpen, setDropdownOpen] = useState(false);
    const [dropdownOpen2, setDropdownOpen2] = useState(false);
    const [dropdownOpen4, setDropdownOpen4] = useState(false);

    // 2.4 États pour les tabs
    const [activeTab, setactiveTab] = useState(1);
    const [progressbarvalue, setprogressbarvalue] = useState(0);
    const [passedSteps, setPassedSteps] = useState([1]);

    // 2.5 États pour les pays
    const [seletedCountry1, setseletedCountry1] = useState({});
    const [seletedCountry3, setseletedCountry3] = useState({
        id: 240,
        flagImg: usflag,
        countryName: "United States of America",
        countryCode: "+1"
    });

    // 2.6 États pour les tooltips
    const [tooltips, setTooltips] = useState(() => {
        const initial = {};
        permissions.forEach(permission => {
            initial[permission.id] = false;
        });
        return initial;
    });

    // 3. Fonctions de toggle
    const toggle = useCallback(() => {
        if (modal) {
            setModal(false);
            setTeamMem(null);
        } else {
            setModal(true);
        }
    }, [modal]);

    const toggle2 = () => setDropdownOpen2(prevState => !prevState);
    const toggle4 = () => setDropdownOpen4(prevState => !prevState);
    const toggledropDown = () => setDropdownOpen(!dropdownOpen);
    const toggleTooltip = useCallback((id) => {
        if (!id) return;
        setTooltips(prev => ({
            ...prev,
            [id]: !prev[id]
        }));
    }, []);

    // 4. Handlers
    const handleSearch = (value) => setSearchTerm(value);
    const handleTeamClicks = () => {
        setTeamMem("");
        setModal(!modal);
        setIsEdit(false);
        toggle();
    };

    // 5. useEffects
    useEffect(() => {
        dispatch(onGetTeamData());
    }, [dispatch]);

    useEffect(() => {
        const fetchUsers = useCallback(async () => {
            try {
                const token = localStorage.getItem('token');
                if (!token) {
                    throw new Error('Token non trouvé');
                }
        
                const response = await fetch('http://inawoapiv3.inawo.pro/utilisateurs/list', {
                    headers: {
                        'Authorization': `Bearer ${token}`,
                        'Accept': 'application/json',
                        'Content-Type': 'application/json'
                    }
                });
        
                if (!response.ok) {
                    throw new Error(`Erreur HTTP: ${response.status}`);
                }
        
                const data = await response.json();
                setTeamList(data);
            } catch (error) {
                console.error("Erreur lors de la récupération des utilisateurs:", error);
                setError(error.message);
            }
        }, []);
        fetchUsers();
    }, []);
    
    

    
    const [isOpen, setIsOpen] = useState(false);
    const [sideBar, setSideBar] = useState([]);

    // 2. États pour les dropdowns
    
    const [dropdownOpen5, setDropdownOpen5] = useState(false);

    // 3. États pour les pays sélectionnés
    
    const [seletedCountry4, setseletedCountry4] = useState({
        id: 240,
        flagImg: usflag,
        countryName: "United States of America",
        countryCode: "+1"
    });

    const handleSubmit = async (values) => {
        try {
            // Récupérer les données du localStorage
            // const userData = JSON.parse(localStorage.getItem('userData')); // Ajustez la clé selon votre stockage
            
            const formData = new FormData();
            formData.append('nom', values.nom);
            formData.append('prenom', values.prenom);
            formData.append('email', values.email);
            formData.append('telephone', values.telephone);
            formData.append('adresse', values.adresse);
            formData.append('ville', values.ville);
            formData.append('pays', values.pays);
            formData.append('password', 'mdp123'); // Vous devriez ajouter un champ pour le mot de passe
            formData.append('type_utilisateur', 'Collaborateur');
            formData.append('langue', 'Fr');
            formData.append('succursale', values.succursale.toString());  // Utilisez directement la valeur du formulaire
            formData.append('magasin', values.magasin.toString());
            formData.append('permission', ''); // À adapter selon vos besoins
    
            const response = await axios({
                method: 'post',
                url: 'https://inawoapiv3.inawo.pro/utilisateurs/inscription/',
                headers: { 
                    'Authorization': `Bearer ${localStorage.getItem('token')}`,
                    'Cookie': 'csrftoken=LbrzaCMaKSJLSCGKq5obthQDWkfyW2uP'
                },
                data: formData
            });
    
            console.log('Utilisateur créé avec succès:', response.data);
            toggle();
            // Rafraîchir la liste des utilisateurs
            fetchUsers();
            
        } catch (error) {
            console.error('Erreur lors de la création de l\'utilisateur:', error);
        }
    };


    

    // 7. Configuration Formik
    const validation = useFormik({
        enableReinitialize: true,
        initialValues: {
            nom: '',
            prenom: '',
            email: '',
            telephone: '',
            adresse: '',
            ville: '',
            pays: '',
            fonction: '',
            succursale: '',
            magasin: ''
        },
        validationSchema: Yup.object({
            nom: Yup.string().required('Le nom est requis'),
            prenom: Yup.string().required('Le prénom est requis'),
            email: Yup.string().email('Email invalide').required('L\'email est requis'),
            fonction: Yup.string().required('La fonction est requise'),
            succursale: Yup.string().required('La succursale est requise'),
            magasin: Yup.string().required('Le magasin est requis')
        }),
        onSubmit: handleSubmit
    });
    // 8. Configuration du Tooltip
    const TOOLTIP_CONFIG = {
        placement: "top",
        fade: true,
        delay: { show: 200, hide: 100 },
        modifiers: [
            {
                name: 'offset',
                options: {
                    offset: [0, 8]
                }
            }
        ]
    };


    
    const toggle5 = () => setDropdownOpen5((prevState) => !prevState);
   
    function toggleTab(tab, value) {
        if (activeTab !== tab) {
            var modifiedSteps = [...passedSteps, tab];

            if (tab >= 1 && tab <= 4) {
                setactiveTab(tab);
                setPassedSteps(modifiedSteps);
            }
        }
        setprogressbarvalue(value);
    }


    useEffect(() => {
        dispatch(onGetTeamData());
    }, [dispatch]);

    useEffect(() => {
        setTeam(teamData);
        // setTeamlist(teamData);
    }, [teamData]);

    

    // Update To do
    const handleTeamClick = useCallback((arg) => {
        const teamMem = arg;
        setTeamMem({
            id: teamMem.id,
