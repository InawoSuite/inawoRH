            <div className="page-content">
                <Container fluid>
                    <BreadCrumb title="Utilisateurs" pageTitle="Dashboard > > " />
                    <Card  style={{ borderRadius: '20px'}}>
                        <CardBody >
                            <Row className="g-2" >
                                <Col sm={4}>
                                    <div className="search-box">
                                        <Input type="text" className="form-control" 
                                        placeholder="Search for name or designation..." 
                                        onChange={(e) => searchList(e.target.value)}
                                        style={{borderRadius:"20px"}}
                                        />
                                        <i className="ri-search-line search-icon"></i>
                                    </div>
                                </Col>
                                <Col className="col-sm-auto ms-auto">
                                    <div className="list-grid-nav hstack gap-1" style={{borderRadius:"20px"}}>

                                        <Button color="info" id="grid-view-button" className="btn btn-soft-info nav-link btn-icon fs-14 active filter-button"
                                        style={{borderRadius:"20px"}}><i className="ri-grid-fill"></i></Button>
                                        <Button color="info" id="list-view-button" className="btn btn-soft-info nav-link  btn-icon fs-14 filter-button"
                                        style={{borderRadius:"20px"}}><i className="ri-list-unordered"></i></Button>
                                        <Dropdown
                                            isOpen={dropdownOpen}
                                            toggle={toggledropDown}>
                                            <DropdownToggle type="button" className="btn btn-soft-info btn-icon fs-14" style={{borderRadius:"20px"}}>
                                                <i className="ri-more-2-fill"></i>
                                            </DropdownToggle>
                                            <DropdownMenu>
                                                <li><Link className="dropdown-item" to="#">All</Link></li>
                                                <li><Link className="dropdown-item" to="#">Last Week</Link></li>
                                                <li><Link className="dropdown-item" to="#">Last Month</Link></li>
                                                <li><Link className="dropdown-item" to="#">Last Year</Link></li>
                                            </DropdownMenu>
                                        </Dropdown>
                                        <Button color="success" onClick={() => handleTeamClicks()} style={{borderRadius:"20px"}}>
                                        <i class="ri-file-add-line me-1  align-bottom"></i>Ajouter un utilisateur</Button>
                                    </div>
                                </Col>
                            </Row>
                        </CardBody>
                    </Card>

                    <Row>
                        <Col lg={12}>
                            <div id="teamlist">
                                <Row className="team-list grid-view-filter">
                                    {filteredUsers.map((user, index) => (
                                        <Col key={index} lg={4}>
                                            <Card className="team-box">
                                                <CardBody className="p-4">
                                                    <Row className="align-items-center">
                                                        <Col className="col-auto">
                                                            <div className="avatar-lg">
                                                                <img 
                                                                    src={`http://inawoapiv3.inawo.pro/utilisateurs/getuser/${user.id}`}
                                                                    alt={`${user.nom} ${user.prenom}`}
                                                                    className="img-fluid rounded-circle"
                                                                    onError={(e) => {
                                                                        e.target.onerror = null;
                                                                        e.target.src = "/utilisateur.png";
                                                                    }}
                                                                />
                                                            </div>
                                                        </Col>
                                                        <Col>
                                                            <h5 className="fs-16 mb-1">
                                                                {user.nom} {user.prenom}
                                                            </h5>
                                                            <p className="text-muted mb-2">{user.fonction}</p>
                                                            <div className="d-flex gap-2">
                                                                <div>
                                                                    <i className="ri-mail-line me-1"></i>
                                                                    {user.email}
                                                                </div>
                                                                <div>
                                                                    <i className="ri-phone-line me-1"></i>
                                                                    {user.telephone}
                                                                </div>
                                                            </div>
                                                        </Col>
                                                        <Col xs="auto">
                                                            <UncontrolledDropdown>
                                                                <DropdownToggle tag="button" className="btn btn-light btn-icon">
                                                                    <i className="ri-more-fill fs-16"></i>
                                                                </DropdownToggle>
                                                                <DropdownMenu end>
                                                                    <DropdownItem onClick={() => handleTeamClick(user)}>
                                                                        <i className="ri-eye-line me-2 align-middle text-muted"></i>
                                                                        Voir
                                                                    </DropdownItem>
                                                                    <DropdownItem onClick={() => handleTeamClick(user)}>
                                                                        <i className="ri-pencil-line me-2 align-middle text-muted"></i>
                                                                        Permissions
                                                                    </DropdownItem>
                                                                    <DropdownItem divider />
                                                                    <DropdownItem onClick={() => onClickData(user)}>
                                                                        <i className="ri-delete-bin-line me-2 align-middle text-muted"></i>
                                                                        Réhabiliter
                                                                    </DropdownItem>
                                                                </DropdownMenu>
                                                            </UncontrolledDropdown>
                                                        </Col>
                                                    </Row>
                                                </CardBody>
                                            </Card>
                                        </Col>
                                    ))}
                                </Row>

                                <div className="modal fade" id="addmembers" tabIndex="-1" aria-hidden="true" >
                                    <div className="modal-dialog modal-dialog-centered ">
                                        <div class="modal-content">
                                            <Modal 
                                                isOpen={modal} 
                                                toggle={toggle} 
                                                centered
                                                size="lg"
                                                className="rounded-4"
                                                modalClassName="border-0" 
                                                contentClassName="rounded-4"
                                                >
                                                                                 
                                                <ModalHeader className="bg-info-subtle p-3 rounded-top-4" toggle={ toggle }>
                                                    { !!isEdit ? "Edit Order" : "Ajouter un utilisateur" }
                                                </ModalHeader>
                                                
                                                <Form onSubmit={validation.handleSubmit}>
                                                    <TabContent activeTab={activeTab} >

                                                            <TabPane tabId={1}>

                                                                <div className="ms-3 me-3 mt-3 mb-3" >
                                                                
                                                                <Row>
                                                                    <Col lg={6}>
                                                                        <div className="mb-3">
                                                                            <Label className="form-label">Nom*</Label>
                                                                            <Input
                                                                                type="text"
                                                                                name="nom"
                                                                                className="form-control"
                                                                                placeholder="Saisissez le nom"
                                                                                style={{borderRadius:"20px"}}
                                                                                value={validation.values.nom || ''}
                                                                                onChange={validation.handleChange}
                                                                                onBlur={validation.handleBlur}
                                                                                // invalid={validation.touched.nom && validation.errors.nom}
                                                                                invalid={!!(validation.touched.nom && validation.errors.nom)}
                                                                            />
                                                                            {validation.touched.nom && validation.errors.nom && (
                                                                                <FormFeedback>{validation.errors.nom}</FormFeedback>
                                                                            )}
                                                                        </div>
                                                                    </Col>
                                                                    <Col lg={6}>
                                                                        <div className="mb-3">
                                                                            <Label className="form-label">Prénom(s)*</Label>
                                                                            <Input
                                                                                type="text"
                                                                                name="prenom"
                                                                                className="form-control"
                                                                                placeholder="Saisissez prénom(s)"
                                                                                style={{borderRadius:"20px"}}
                                                                                value={validation.values.prenom || ''}
                                                                                onChange={validation.handleChange}
                                                                                onBlur={validation.handleBlur}
                                                                                invalid={!!(validation.touched.prenom && validation.errors.prenom)}
                                                                            />
                                                                            {validation.touched.prenom && validation.errors.prenom && (
                                                                                <FormFeedback>{validation.errors.prenom}</FormFeedback>
                                                                            )}
                                                                        </div>
                                                                    </Col>          
                                                                </Row>

                                                                <Row>
                                                                    <Col lg={6}>
                                                                        <div className="mb-3">
                                                                            <Label className="form-label">Email*</Label>
                                                                            <Input
                                                                                type="email"
                                                                                name="email"
                                                                                className="form-control"
                                                                                placeholder="Saisissez adresse email"
                                                                                style={{borderRadius:"20px"}}
                                                                                value={validation.values.email || ''}
                                                                                onChange={validation.handleChange}
                                                                                onBlur={validation.handleBlur}
                                                                                invalid={!!(validation.touched.email && validation.errors.email)}
                                                                            />
                                                                            {validation.touched.email && validation.errors.email && (
                                                                                <FormFeedback>{validation.errors.email}</FormFeedback>
                                                                            )}
                                                                        </div>
                                                                    </Col>
                                                                    <Col lg={6}>
                                                                        <div className="mb-3">
                                                                            <Label className="form-label">Fonction*</Label>
                                                                            <Input
                                                                                type="text"
                                                                                name="fonction"
                                                                                className="form-control"
                                                                                placeholder="Saisissez fonction"
                                                                                style={{borderRadius:"20px"}}
                                                                                value={validation.values.fonction || ''}
                                                                                onChange={validation.handleChange}
                                                                                onBlur={validation.handleBlur}
                                                                                invalid={!!(validation.touched.fonction && validation.errors.fonction)}
                                                                            />
                                                                            {validation.touched.fonction && validation.errors.fonction && (
                                                                                <FormFeedback>{validation.errors.fonction}</FormFeedback>
                                                                            )}
                                                                        </div>
                                                                    </Col>
                                                                </Row>

                                                                <Row>
                                                                    <Col lg={6}>
                                                                        <div className="mb-3">
                                                                            <Label className="form-label">Adresse</Label>
                                                                            <Input
                                                                                type="text"
                                                                                name="adresse"
                                                                                className="form-control"
                                                                                placeholder="Saisissez adresse"
                                                                                style={{borderRadius:"20px"}}
                                                                                value={validation.values.adresse || ''}
                                                                                onChange={validation.handleChange}
                                                                                onBlur={validation.handleBlur}
                                                                                invalid={!!(validation.touched.adresse && validation.errors.adresse)}
                                                                            />
                                                                            {validation.touched.adresse && validation.errors.adresse && (
                                                                                <FormFeedback>{validation.errors.adresse}</FormFeedback>
                                                                            )}
                                                                        </div>
                                                                    </Col>
                                                                    <Col lg={6}>
                                                                        <div className="mb-3">
                                                                            <Label className="form-label">Succursale</Label>
                                                                            {isLoading ? (
                                                                                <div className="text-center">
                                                                                    <div className="spinner-border text-primary" role="status">
                                                                                        <span className="visually-hidden">Chargement...</span>
                                                                                    </div>
                                                                                </div>
                                                                            ) : error ? (
                                                                                <div className="alert alert-danger">{error}</div>
                                                                            ) : (
                                                                                <>
                                                                                    {userData && userData.magasins && userData.magasins.length > 0 ? (
                                                                                        <Input
                                                                                            type="select"
                                                                                            name="succursale"
                                                                                            className="form-control"
                                                                                            style={{borderRadius:"20px"}}
                                                                                            value={validation.values.succursale || ''}
                                                                                            onChange={validation.handleChange}
                                                                                            onBlur={validation.handleBlur}
                                                                                            invalid={!!(validation.touched.succursale && validation.errors.succursale)}
                                                                                        >
                                                                                            <option value="">Sélectionnez une succursale</option>
                                                                                            {userData.magasins.map(magasin => (
                                                                                                <option key={magasin.groupe_id} value={magasin.groupe_id}>
                                                                                                    {magasin.nom}
                                                                                                </option>
                                                                                            ))}
                                                                                        </Input>
                                                                                    ) : (
                                                                                        <div className="alert alert-warning">
                                                                                            Aucune succursale disponible
                                                                                        </div>
                                                                                    )}


                                                                                    {validation.touched.succursale && validation.errors.succursale && (
                                                                                        <FormFeedback>{validation.errors.succursale}</FormFeedback>
                                                                                    )}
                                                                                </>
                                                                            )}
                                                                        </div>
                                                                    </Col>
                                                                </Row>

                                                                <Row>
                                                                    <Col lg={6}>
                                                                        <div className="mb-3">
                                                                            <Label className="form-label">Téléphone</Label>
                                                                            <div className="input-group">
                                                                                <Dropdown isOpen={dropdownOpen4} toggle={toggle4}>
                                                                                    <DropdownToggle 
                                                                                        tag="button" 
                                                                                        className="btn btn-light" 
                                                                                        style={{borderTopLeftRadius: "20px", borderBottomLeftRadius: "20px"}}
                                                                                    >
                                                                                        <img src={seletedCountry3.flagImg} alt="country flag" className="options-flagimg" height="20" />
                                                                                        <span className="countrylist-codeno text-muted">{seletedCountry3.countryCode}</span>
                                                                                    </DropdownToggle>
                                                                                    <DropdownMenu className="dropdown-menu-list">
                                                                                    <SimpleBar style={{ maxHeight: "220px" }} className="px-3">
                                                                                        {(country || []).map((item, key) => (
                                                                                            <DropdownItem as='li' onClick={() => setseletedCountry3(item)} key={key} className="dropdown-item d-flex">
                                                                                                <div className="flex-shrink-0 me-2">
                                                                                                    <img src={item.flagImg} alt="country flag" className="options-flagimg" height="20" />
                                                                                                </div>
                                                                                                <div className="flex-grow-1">
                                                                                                    <div className="d-flex">
                                                                                                        <div className="country-name me-1">{item.countryName}</div>
                                                                                                        <span className="countrylist-codeno text-muted">{item.countryCode}</span>
                                                                                                    </div>
                                                                                                </div>
                                                                                            </DropdownItem>
                                                                                        ))}
                                                                                    </SimpleBar>
                                                                                </DropdownMenu>
                                                                                </Dropdown>
                                                                                <Input
                                                                                    type="text"
                                                                                    name="telephone"
                                                                                    className="form-control"
                                                                                    placeholder="Entrer le numéro"
                                                                                    style={{borderTopRightRadius: "20px", borderBottomRightRadius: "20px"}}
                                                                                    value={validation.values.telephone || ''}
                                                                                    onChange={validation.handleChange}
                                                                                    onBlur={validation.handleBlur}
                                                                                    invalid={!!(validation.touched.telephone && validation.errors.telephone)}
                                                                                />
                                                                                {validation.touched.telephone && validation.errors.telephone && (
                                                                                    <FormFeedback>{validation.errors.telephone}</FormFeedback>
                                                                                )}
                                                                            </div>
                                                                        </div>
                                                                    </Col>
                                                                    <Col lg={6}>
                                                                        <div className="mb-3">
                                                                            <Label className="form-label">Pays*</Label>
                                                                            <div className="input-group w-100">
                                                                                <Dropdown isOpen={dropdownOpen2} toggle={toggle2} className="w-100">
                                                                                    <DropdownToggle
                                                                                        tag="button"
                                                                                        caret={false} 
                                                                                        type="text" 
                                                                                        style={{
                                                                                            backgroundImage: `url(${seletedCountry1.flagImg})`,
                                                                                            borderRadius: "20px",
                                                                                            width: "100%",
                                                                                            height: "38px",
                                                                                            backgroundColor: "#fff",
                                                                                            border: "1px solid #ced4da"
                                                                                        }}
                                                                                        className="form-control d-flex align-items-center"
                                                                                    >
                                                                                        <div className="d-flex align-items-center w-100">
                                                                                            {seletedCountry1.flagImg && (
                                                                                                <img 
                                                                                                    src={seletedCountry1.flagImg} 
                                                                                                    alt="country flag" 
                                                                                                    className="options-flagimg me-2" 
                                                                                                    height="20" 
                                                                                                />
                                                                                            )}
                                                                                            <span className="flex-grow-1 text-start">
                                                                                                {seletedCountry1.countryName || 'Choisissez pays'}
                                                                                            </span>
                                                                                        </div>
                                                                                    </DropdownToggle>
                                                                                    <DropdownMenu 
                                                                                        as='ul' 
                                                                                        className="list-unstyled w-100 dropdown-menu-list mb-0" 
                                                                                        style={{
                                                                                            borderRadius: "20px",
                                                                                            width: "100%"
                                                                                        }}
                                                                                    >
                                                                                        <SimpleBar style={{ maxHeight: "220px" }} className="px-3">
                                                                                            {(country || []).map((item, key) => (
                                                                                                <DropdownItem 
                                                                                                    as='li' 
                                                                                                    onClick={() => {
                                                                                                        setseletedCountry1(item);
                                                                                                        validation.setFieldValue('pays', item.countryName);
                                                                                                    }} 
                                                                                                    key={key} 
                                                                                                    className="dropdown-item d-flex"
                                                                                                >
                                                                                                    <div className="flex-shrink-0 me-2">
                                                                                                        <img 
                                                                                                            src={item.flagImg} 
                                                                                                            alt="country flag" 
                                                                                                            className="options-flagimg" 
                                                                                                            height="20" 
                                                                                                        />
                                                                                                    </div>
                                                                                                    <div className="flex-grow-1">
                                                                                                        <div className="d-flex">
                                                                                                            <div className="country-name me-1">
                                                                                                                {item.countryName}
                                                                                                            </div>
                                                                                                            <span className="countrylist-codeno text-muted">
                                                                                                                {item.countryCode}
                                                                                                            </span>
                                                                                                        </div>
                                                                                                    </div>
                                                                                                </DropdownItem>
                                                                                            ))}
                                                                                        </SimpleBar>
                                                                                    </DropdownMenu>
                                                                                </Dropdown>
                                                                            </div>
                                                                            {validation.touched.pays && validation.errors.pays && (
                                                                                <FormFeedback style={{display: 'block'}}>
                                                                                    {validation.errors.pays}
                                                                                </FormFeedback>
                                                                            )}
                                                                        </div>
                                                                    </Col>
                                                                </Row>

                                                                <Row>
                                                                    <Col lg={6}>
                                                                        <div className="mb-3">
                                                                            <Label className="form-label">Magasin</Label>
                                                                            <Input
                                                                                type="select"
                                                                                name="magasin"
                                                                                className="form-control"
                                                                                style={{borderRadius:"20px"}}
                                                                                value={validation.values.magasin || ''}
                                                                                onChange={validation.handleChange}
                                                                                onBlur={validation.handleBlur}
                                                                            >
                                                                                <option value="">Sélectionnez un magasin</option>
                                                                                {userData?.magasins?.map(magasin => (
                                                                                    <option key={magasin.id} value={magasin.id}>
                                                                                        {magasin.nom}
                                                                                    </option>
                                                                                ))}
                                                                            </Input>

                                                                        </div>
                                                                    </Col>
                                                                </Row>

                                                                    <div className="d-flex align-items-start gap-3 mt-4">
                                                                        <button
                                                                            type="button"
                                                                            className="btn btn-success btn-label right ms-auto nexttab nexttab"
                                                                            onClick={() => {
                                                                                toggleTab(activeTab + 1, 50);
                                                                            }}
                                                                            style={{borderRadius:"20px"}}
                                                                        >
                                                                            <i className="ri-arrow-right-line label-icon align-middle fs-16 ms-2"></i>
                                                                            Suivant
                                                                        </button>
                                                                    </div>
                                                                </div>
                                                                
                                                            </TabPane>

                                                            <TabPane tabId={2}>
                                                                

                                                                <div className="bg-light p-3">
                                                                    <h6>Attribuer des permissioons</h6>
                                                                </div>
                                                                
                                                                <div className="ms-3 me-3 mt-3 mb-3">
                                                                    {permissions.map((permission, index) => (
                                                                        index % 2 === 0 && (
                                                                            <Row className="justify-content-between" key={permission.id}>
                                                                                <Col lg={5} className="ms-4">
                                                                                    <div className="mb-3">
                                                                                        <div 
                                                                                            className="form-check form-switch" 
                                                                                            id={`tooltip-${permission.id}`}
                                                                                            onMouseEnter={() => toggleTooltip(permission.id)}
                                                                                            onMouseLeave={() => toggleTooltip(permission.id)}
                                                                                        >
                                                                                            <Input 
                                                                                                className="form-check-input" 
                                                                                                type="checkbox" 
                                                                                                role="switch" 
                                                                                                id={`switch-${permission.id}`} 
                                                                                            />
                                                                                            <span>{permission.label}</span>
                                                                                        </div>
                                                                                        <Tooltip
                                                                                           {...TOOLTIP_CONFIG}
                                                                                           isOpen={tooltips[permission.id]}
                                                                                           target={`tooltip-${permission.id}`}
                                                                                           toggle={() => toggleTooltip(permission.id)}
                                                                                            // isOpen={tooltips[permission.id]}
                                                                                            // target={`tooltip-${permission.id}`}
                                                                                            // placement="top"
                                                                                            // fade={true}
                                                                                            // delay={{ show: 200, hide: 100 }}
                                                                                            transition={{ timeout: 200 }}  

                                                                                        >
                                                                                            {permission.description}
                                                                                        </Tooltip>
                                                                                    </div>
                                                                                </Col>
                                                                                {permissions[index + 1] && (
                                                                                    <Col lg={6}>
                                                                                        <div className="mb-3">
                                                                                            <div 
                                                                                                className="form-check form-switch mb-2" 
                                                                                                id={`tooltip-${permissions[index + 1].id}`}
                                                                                                onMouseEnter={() => toggleTooltip(permissions[index + 1].id)}
                                                                                                onMouseLeave={() => toggleTooltip(permissions[index + 1].id)}
                                                                                            >
                                                                                                <Input 
                                                                                                    className="form-check-input" 
                                                                                                    type="checkbox" 
                                                                                                    role="switch" 
                                                                                                    id={`switch-${permissions[index + 1].id}`} 
                                                                                                />
                                                                                                <span>{permissions[index + 1].label}</span>
                                                                                            </div>
                                                                                            <Tooltip
                                                                                                {...TOOLTIP_CONFIG}
                                                                                                isOpen={tooltips[permissions[index + 1].id]}
                                                                                                target={`tooltip-${permissions[index + 1].id}`}
                                                                                                toggle={() => toggleTooltip(permissions[index + 1].id)}
                                                                                                // isOpen={tooltips[permissions[index + 1].id]}
                                                                                                // target={`tooltip-${permissions[index + 1].id}`}
                                                                                                // placement="top"
                                                                                                // fade={true}
                                                                                                // delay={{ show: 200, hide: 100 }}
                                                                                                transition={{ timeout: 200 }}  // Ajouter cette ligne

                                                                                            >
                                                                                                {permissions[index + 1].description}
                                                                                            </Tooltip>
                                                                                        </div>
                                                                                    </Col>
                                                                                )}
                                                                            </Row>
                                                                        )
                                                                    ))}

                                                                <Row className="justify-content-between">
                                                                    <div className="d-flex align-items-center gap-3 mt-4 w-100 justify-content-between">
                                                                        <button
                                                                            type="button"
                                                                            className="btn btn-link text-decoration-none btn-label previestab"
                                                                            onClick={() => toggleTab(activeTab - 1, 0)}
                                                                            style={{borderRadius:"20px"}}
                                                                        >
                                                                            <i className="ri-arrow-left-line label-icon align-middle fs-16 me-2"></i>
                                                                            Précédent
                                                                        </button>
                                                                        {/* <button
                                                                            type="submit"
                                                                            className="btn btn-success btn-label "
                                                                            onClick={() => toggleTab(activeTab + 1, 100)}
                                                                            style={{borderRadius:"20px"}}
                                                                        >
                                                                            Ajouter utilisateur
                                                                            <i className="ri-arrow-right-line label-icon align-middle fs-16 ms-2"></i>
                                                                        </button> */}
                                                                        <Button color="success" onClick={() => handleTeamClicks()} style={{borderRadius:"20px"}}>
                                                                            <i className="ri-file-add-line me-1 align-bottom"></i>
                                                                            Ajouter un utilisateur
                                                                        </Button>
                                                                    </div>
                                                                </Row>
                                                                </div>
                                                            </TabPane>

                                                            <TabPane tabId={3}>
                                                                <div className="ms-3 me-3 mt-3 mb-3">
                                                                    <div className="text-center">
                                                                        <div className="mb-3">
                                                                            <lord-icon
                                                                                src="https://cdn.lordicon.com/lupuorrc.json"
                                                                                trigger="loop"
                                                                                colors="primary:#0ab39c,secondary:#405189"
                                                                                style={{ width: "120px", height: "120px" }}
                                                                            ></lord-icon>
                                                                        </div>
                                                                        <h5>Félicitations !</h5>
                                                                        <p className="text-muted">
                                                                            Vous venez d'ajouter un utilisateur.
                                                                            Demandez lui de consulter son mail.
                                                                        </p>
                                                                    </div>
                                                                </div>
                                                            </TabPane>
                                                    </TabContent>
                                                </Form>
                                            
    
                                            </Modal>
                                        </div>
                                    </div>
                                </div>


                            </div>
                            <div className="py-4 mt-4 text-center" id="noresult" style={{ display: "none" }}>
                                <lord-icon src="https://cdn.lordicon.com/msoeawqm.json" trigger="loop" colors="primary:#405189,secondary:#0ab39c" style={{ width: "72px", height: "72px" }}></lord-icon>
                                <h5 className="mt-4">Sorry! No Result Found</h5>
                            </div>
                        </Col>
                    </Row>
                </Container>
                
            </div>
        </React.Fragment>
    );
};

export default Team;